{
  "name": "explainer-video",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-theme animated explainer videos: content-first scenes, GSAP + PixiJS + Rapier, frame-stepped on the GPU with Puppeteer + ffmpeg",
